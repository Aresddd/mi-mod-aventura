{
  "format_version": "1.21.0",
  "animation_controllers": {
    "controller.animation.aldeano_sifonado.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            {
              "move": "query.is_moving"
            },
            {
              "attack": "query.has_target && query.attack_time > 0"
            },
            {
              "death": "query.is_dead"
            }
          ]
        },
        "move": {
          "animations": ["move"],
          "transitions": [
            {
              "idle": "!query.is_moving"
            },
            {
              "attack": "query.has_target && query.attack_time > 0"
            },
            {
              "death": "query.is_dead"
            }
          ]
        },
        "attack": {
          "animations": ["attack"],
          "transitions": [
            {
              "idle": "query.attack_time <= 0 || !query.has_target"
            },
            {
              "death": "query.is_dead"
            }
          ]
        },
        "death": {
          "animations": ["death"],
          "transitions": []
        }
      }
    }
  }
}