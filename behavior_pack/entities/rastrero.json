{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "sifon:rastrero",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": [
          "move",
          "look_at_target"
        ],
        "pre_animation": [
          "controller.animation.rastrero.general"
        ]
      },
      "animations": {
        "move": "animation.rastrero.move",
        "look_at_target": "animation.common.look_at_target",
        "idle": "animation.rastrero.idle",
        "attack": "animation.rastrero.attack",
        "death": "animation.rastrero.death"
      },
      "animation_controllers": [
        {
          "controller.animation.rastrero.general": "controller.animation.rastrero.general"
        }
      ],
      "geometry": {
        "default": "geometry.rastrero"
      },
      "materials": {
        "default": "entity_alphatest",
        "corrupted": "entity_alphatest_emissive"
      },
      "textures": {
        "default": "textures/entity/rastrero",
        "corrupted": "textures/entity/rastrero_corrupted"
      },
      "spawn_egg": {
        "base_color": "#1a1a2e",
        "overlay_color": "#7b2cbf"
      }
    },
    "component_groups": {
      "sifon:corrupted_state": {
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:material_variants": {
          "corrupted": "corrupted"
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["rastrero", "monster", "sifon_corrupted"]
      },
      "minecraft:health": {
        "value": 15,
        "max": 15
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:navigation.walk": {
        "can_pass_doors": true,
        "can_open_doors": false,
        "avoid_sun": false
      },
      "minecraft:jump.static": {
        "jump_power": 0.42
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 16
          }
        ],
        "must_see": true
      },
      "minecraft:behavior.melee_attack": {
        "priority": 2,
        "speed_multiplier": 1.2,
        "track_target": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 5,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/rastrero.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 3 + math.random(2) : 0"
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 32,
          "max_distance": 64
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "weight": 70,
            "remove": {
                "component_groups": ["sifon:corrupted_state"]
            }
          },
          {
            "weight": 30,
            "add": {
                "component_groups": ["sifon:corrupted_state"]
            }
          }
        ]
      },
      "minecraft:on_hurt": {
        "run_command": {
          "command": "particle sifon:corruption_hurt ~ ~1 ~"
        }
      }
    }
  }
}