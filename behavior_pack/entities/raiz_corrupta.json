{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "sifon:raiz_corrupta",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "sifon:raiz_active": {
        "minecraft:damage_sensor": {
          "triggers": {
            "cause": "all",
            "on_damage": {
              "event": "sifon:raiz_damage"
            }
          }
        },
        "minecraft:timer": {
          "time": 4.0,
          "looping": false,
          "time_down_event": {
            "event": "sifon:raiz_despawn"
          }
        }
      },
      "sifon:raiz_burst": {
        "minecraft:damage_sensor": {
          "triggers": {
            "cause": "all",
            "on_damage": {
              "event": "sifon:raiz_damage"
            }
          }
        },
        "minecraft:timer": {
          "time": 2.5,
          "looping": false,
          "time_down_event": {
            "event": "sifon:raiz_despawn"
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["raiz_corrupta", "sifon_corrupted"]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1
      },
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 1.5
      },
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:physics": {},
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "within_radius": 3.5,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 3.5
          }
        ],
        "must_see": false,
        "must_reach": false
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "on_damage": {
            "event": "sifon:raiz_damage"
          }
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["sifon:raiz_active"]
        },
        "queue_command": {
          "command": [
            "particle minecraft:block soul_soil ~ ~0.2 ~ 0.4 0.4 0.4 0.05 10",
            "playsound block.roots.place @a[r=20] ~ ~ ~ 0.8 1.2"
          ]
        }
      },
      "sifon:raiz_damage": {
        "queue_command": {
          "command": [
            "damage @e[type=player,r=1.2] 6 magic"
          ]
        }
      },
      "sifon:raiz_despawn": {
        "queue_command": {
          "command": [
            "particle minecraft:dripstone_drip_lava ~ ~1 ~ 0.3 0.5 0.3 0.02 15",
            "kill @e[type=sifon:raiz_corrupta,r=0.5]"
          ]
        },
        "remove": {
          "component_groups": ["sifon:raiz_active", "sifon:raiz_burst"]
        }
      }
    }
  }
}