{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "sifon:doncella_cristal",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": [
          "look_at_target"
        ]
      },
      "animations": {
        "look_at_target": "animation.common.look_at_target",
        "idle": "animation.doncella_cristal.idle",
        "move": "animation.doncella_cristal.move",
        "attack_shard": "animation.doncella_cristal.attack_shard",
        "attack_shard_burst": "animation.doncella_cristal.attack_shard_burst",
        "reposition": "animation.doncella_cristal.reposition",
        "phase_transition": "animation.doncella_cristal.phase_transition",
        "death": "animation.doncella_cristal.death"
      },
      "animation_controllers": [
        {
          "controller.animation.doncella_cristal.general": "controller.animation.doncella_cristal.general"
        }
      ],
      "geometry": {
        "default": "geometry.doncella_cristal"
      },
      "materials": {
        "default": "entity_alphatest",
        "crystal_intact": "entity_alphatest_emissive",
        "crystal_corrupted": "entity_alphatest_emissive"
      },
      "textures": {
        "default": "textures/entity/doncella_cristal",
        "phase2": "textures/entity/doncella_cristal_phase2"
      },
      "spawn_egg": {
        "base_color": "#8ae6ff",
        "overlay_color": "#2d0047"
      }
    },
    "component_groups": {
      "sifon:phase_monitor": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "test": "is_missing_health",
                "subject": "self",
                "value": 100
              },
              "event": "sifon:start_phase2"
            }
          ]
        }
      },
      "sifon:phase2_transition": {
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:timer": {
          "time": 3.0,
          "looping": false,
          "time_down_event": {
            "event": "sifon:finish_phase2"
          }
        }
      },
      "sifon:phase2_engaged": {
        "minecraft:mark_variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.28
        },
        "minecraft:attack": {
          "damage": 10
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 2,
          "speed_multiplier": 1.0,
          "attack_interval_min": 1.2,
          "attack_interval_max": 2.0,
          "attack_radius": 20.0,
          "attack_radius_min": 4.0,
          "charge_charged_trigger": 0.5,
          "charge_shoot_trigger": 1.0
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["doncella_cristal", "boss", "monster", "sifon_corrupted"]
      },
      "minecraft:health": {
        "value": 220,
        "max": 220
      },
      "minecraft:boss": {
        "should_darken_sky": false,
        "hud_range": 50
      },
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 2.1
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "can_pass_doors": true,
        "avoid_water": true,
        "can_open_doors": true
      },
      "minecraft:jump.static": {},
      "minecraft:attack": {
        "damage": 7
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:follow_range": {
        "value": 35
      },
      "minecraft:persistent": {},
      "minecraft:fire_immune": true,
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:nameable": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 55 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/doncella_cristal.json"
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "set_alert_target": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "within_radius": 30,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 30
          }
        ],
        "must_see": true
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 3,
        "speed_multiplier": 1.0,
        "attack_interval_min": 1.5,
        "attack_interval_max": 2.5,
        "attack_radius": 18.0,
        "attack_radius_min": 5.0,
        "charge_charged_trigger": 0.6,
        "charge_shoot_trigger": 1.2
      },
      "minecraft:behavior.move_away_from_target": {
        "priority": 4,
        "speed_multiplier": 1.2,
        "distance": 8.0,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            }
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 12
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["sifon:phase_monitor"]
        }
      },
      "sifon:start_phase2": {
        "remove": {
          "component_groups": ["sifon:phase_monitor"]
        },
        "add": {
          "component_groups": ["sifon:phase2_transition"]
        },
        "queue_command": {
          "command": [
            "playsound mob.warden.soul_escape @a[r=48]",
            "particle minecraft:end_gateway_spawn_emitter ~ ~1.2 ~"
          ]
        }
      },
      "sifon:finish_phase2": {
        "remove": {
          "component_groups": ["sifon:phase2_transition"]
        },
        "add": {
          "component_groups": ["sifon:phase2_engaged"]
        },
        "queue_command": {
          "command": [
            "playsound mob.warden.heartbeat @a[r=48]",
            "particle minecraft:flash ~ ~1.2 ~"
          ]
        }
      }
    }
  }
}